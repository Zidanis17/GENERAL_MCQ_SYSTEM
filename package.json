{
  "name": "mcq-studio",
  "version": "1.1.1",
  "description": "A quiet place to practice. Offline question banks, exams, and progress.",
  "author": "MCQ Studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run runtime && npm run icons",
    "dev": "node scripts/electron.mjs dev",
    "start": "node scripts/electron.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run runtime && npm run build && playwright test",
    "test:portable": "node scripts/smoke-portable.mjs",
    "test:updates": "node scripts/smoke-updates.mjs",
    "build": "npm run typecheck && electron-vite build",
    "icons": "node scripts/create-icon.mjs",
    "runtime": "node scripts/ensure-runtime.mjs",
    "package:win": "npm run runtime && npm run icons && npm run build && electron-builder --win --x64 --publish never",
    "updates:configure": "node scripts/configure-updates.mjs",
    "release:win": "npm run package:win && powershell.exe -NoProfile -File scripts/Publish-Release.ps1",
    "deliver": "node scripts/deliver.mjs"
  },
  "dependencies": {
    "electron-store": "12.0.0",
    "electron-updater": "6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.mcqstudio.desktop",
    "productName": "MCQ Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "MCQ-Studio-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MCQ-Studio-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "publish": {
      "provider": "github",
      "owner": "Zidanis17",
      "repo": "GENERAL_MCQ_SYSTEM",
      "releaseType": "draft",
      "publishAutoUpdate": true
    }
  }
}
