{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCQ Studio question bank v1",
  "description": "UTF-8 JSON, maximum 10 MiB. Question IDs must be unique within the bank; option IDs must be unique within each question. correctOptionId must reference an option in the same question. The application additionally checks those cross-field constraints.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/nonblank" },
    "title": { "$ref": "#/$defs/nonblank" },
    "description": { "type": "string" },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "prompt", "options", "correctOptionId"],
        "properties": {
          "id": { "$ref": "#/$defs/nonblank" },
          "prompt": { "$ref": "#/$defs/nonblank" },
          "correctOptionId": { "$ref": "#/$defs/nonblank" },
          "explanation": { "type": "string" },
          "options": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "required": ["id", "text"],
              "properties": { "id": { "$ref": "#/$defs/nonblank" }, "text": { "$ref": "#/$defs/nonblank" } }
            }
          }
        }
      }
    }
  },
  "$defs": { "nonblank": { "type": "string", "minLength": 1, "pattern": "\\S" } }
}
